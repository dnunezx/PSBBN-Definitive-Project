--- a/arch/mips/kernel/head.S
+++ b/arch/mips/kernel/head.S
@@ -201,6 +201,19 @@
 	 sw	zero, (t0)
 #endif
 
+	/* Preserve boot arguments across the screen-only entry marker. */
+	addiu	sp, sp, -32
+	sw	a0, 16(sp)
+	sw	a1, 20(sp)
+	sw	a2, 24(sp)
+	sw	a3, 28(sp)
+	jal	psbbn_trace_entry
+	 nop
+	lw	a0, 16(sp)
+	lw	a1, 20(sp)
+	lw	a2, 24(sp)
+	lw	a3, 28(sp)
+	addiu	sp, sp, 32
 	jal	init_arch
 	 nop
 	END(kernel_entry)
