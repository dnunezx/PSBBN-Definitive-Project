IOP_BIN = ../../build/apa_sync.irx
IOP_OBJS = hdd_fio.o hdd_blkio.o hdd.o imports.o password.o misc.o cache.o apa.o journal.o free.o
IOP_SRC_DIR = src/
IOP_INC_DIR = src/
IOP_OBJS_DIR = ../../build/apa_sync/
IOP_CFLAGS = -DAPA_USE_ATAD -DAPA_OSD_VER -DAPA_8MB_PARTITION_SIZE -DIOMANX_OLD_NAME_COMPATIBILITY=0 -DIOMANX_OLD_NAME_ADDDELDRV=0 -I../libapa/include
.DEFAULT_GOAL := all
all: $(IOP_BIN)
include $(PS2SDK)/Defs.make
include $(PS2SDK)/samples/Makefile.iopglobal
$(IOP_OBJS_DIR)%.o: ../libapa/src/%.c
	$(IOP_CC) $(IOP_CFLAGS) $(IOP_INCS) -c $< -o $@
